# ---------------------------------------------------------------------------
# study.companion
#
# Keep the repository small: everything ignored here is either a build
# output, a dependency, or a cache. None of it is needed to run the site —
# `npm install && npm run dev` recreates all of it.
# ---------------------------------------------------------------------------

# --- Dependencies ---------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/

# --- Build outputs --------------------------------------------------------
# `output: 'export'` writes here; next.config.js sets distDir to 'dist'.
dist/
out/
build/
.next/
*.tsbuildinfo
next-env.d.ts.bak

# --- Generated search index (rebuilt on every `npm run build`) -----------
public/search-index.json

# --- Caches ---------------------------------------------------------------
.npm
.cache
.turbo
.parcel-cache
.eslintcache
.stylelintcache
.vercel
.netlify
.swc/
node_modules/.cache

# --- Logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-error.log*
.core
*.stackdump

# --- Environment ----------------------------------------------------------
.env
.env.*
!.env.example

# --- OS and editor cruft --------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# --- Test and coverage ----------------------------------------------------
coverage/
.nyc_output/
*.lcov

# --- Extracted textbook figures -------------------------------------------
# 541 files, ~56 MB, extracted from the Class 6-12 PDFs. They are real
# content, not build output — but they are large binaries, and a fresh
# `git clone` will not have them.
#
# IMPORTANT: they are NOT regenerable from this repository. The source PDFs
# are no longer kept here, so if you lose public/figures/ the site renders
# without images. Keep a backup (the setup zip carries all 541), and refer
# to SETUP.md if you need to restore them.
public/figures/
